---
import { contact, profile } from '../data/site';
import T from './T.astro';
---
<section class="section contact" id="contact">
  <div class="wrap">
    <p class="section-label">04 — <T en={contact.heading.en} ja={contact.heading.ja} /></p>

    <div class="body reveal">
      <h2 class="big">
        <T en={contact.cta.en} ja={contact.cta.ja} />
      </h2>
      <p class="lead"><T en={contact.body.en} ja={contact.body.ja} /></p>

      <a class="primary-link" href={profile.primary.href} target="_blank" rel="noopener noreferrer">
        <span class="handle">{profile.primary.handle}</span>
        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
          <path d="M5 11L11 5M11 5H6M11 5v5" fill="none" stroke="currentColor"
                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <ul class="links">
        {profile.socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .contact { position: relative; overflow: hidden; }
  .contact::before {
    content: '';
    position: absolute;
    bottom: -50%;
    left: 50%;
    width: min(800px, 110vw);
    aspect-ratio: 1;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(198, 242, 78, 0.07) 0%, transparent 60%);
    pointer-events: none;
  }
  .body { position: relative; }

  .big {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }

  .lead {
    color: var(--muted);
    max-width: 48ch;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    margin-bottom: 2.5rem;
  }

  .primary-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.6vw, 1.5rem);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line-hi);
    transition: color 0.25s ease, border-color 0.25s ease;
    overflow-wrap: anywhere;
  }
  .primary-link:hover { color: var(--accent); border-color: var(--accent); }
  .primary-link svg { flex: none; transition: transform 0.25s ease; }
  .primary-link:hover svg { transform: translate(2px, -2px); }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 3rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--faint);
  }
  .links a { transition: color 0.2s ease; }
  .links a:hover { color: var(--accent); }
</style>
