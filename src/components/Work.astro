---
import { work } from '../data/site';
import T from './T.astro';

const featured = work.items.filter((p) => p.featured);
const archive = work.items.filter((p) => !p.featured);
---
<section class="section" id="work">
  <div class="wrap">
    <p class="section-label">03 — <T en={work.heading.en} ja={work.heading.ja} /></p>

    <div class="grid">
      {featured.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <Tag
            class:list={['card', 'reveal', { linked: !!p.href }]}
            href={p.href}
            target={p.href ? '_blank' : undefined}
            rel={p.href ? 'noopener noreferrer' : undefined}
          >
            <div class="card-top">
              <span class="year">{p.year}</span>
              {p.href ? (
                <svg class="arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                  <path d="M5 11L11 5M11 5H6M11 5v5" fill="none" stroke="currentColor"
                        stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : (
                <span class="private"><T en={work.privateLabel.en} ja={work.privateLabel.ja} /></span>
              )}
            </div>

            <h3 class="title"><T en={p.name.en} ja={p.name.ja} /></h3>
            <p class="blurb"><T en={p.blurb.en} ja={p.blurb.ja} /></p>

            <ul class="tags">
              {p.tags.map((t) => <li>{t}</li>)}
            </ul>
          </Tag>
        );
      })}
    </div>

    <h3 class="archive-heading">
      <T en={work.archiveHeading.en} ja={work.archiveHeading.ja} />
    </h3>
    <ul class="archive">
      {archive.map((p) => (
        <li class="reveal">
          <a href={p.href} target="_blank" rel="noopener noreferrer">
            <span class="a-year">{p.year}</span>
            <span class="a-name"><T en={p.name.en} ja={p.name.ja} /></span>
            <span class="a-blurb"><T en={p.blurb.en} ja={p.blurb.ja} /></span>
            <span class="a-tags">{p.tags.join(' · ')}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    min-height: 250px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(600px circle at var(--mx, 50%) var(--my, 0%),
                rgba(198, 242, 78, 0.07), transparent 45%);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .card.linked:hover {
    border-color: var(--line-hi);
    background: var(--surface-hi);
    transform: translateY(-3px);
  }
  .card:hover::before { opacity: 1; }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .year {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--faint);
  }
  .arrow { color: var(--faint); transition: color 0.25s ease, transform 0.25s ease; }
  .card.linked:hover .arrow { color: var(--accent); transform: translate(2px, -2px); }
  .private {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.15rem 0.45rem;
  }

  .title {
    font-size: 1.3rem;
    margin-bottom: 0.7rem;
    transition: color 0.25s ease;
  }
  .card.linked:hover .title { color: var(--accent); }

  .blurb {
    color: var(--muted);
    font-size: 0.925rem;
    flex: 1;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.5rem;
  }
  .tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 0.2rem 0.5rem;
  }

  .archive-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 4rem 0 0.5rem;
  }

  .archive { border-top: 1px solid var(--line); }
  .archive li { border-bottom: 1px solid var(--line); }
  .archive a {
    display: grid;
    grid-template-columns: 70px 200px 1fr auto;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.1rem 0;
    transition: padding 0.25s ease, color 0.25s ease;
  }
  .archive a:hover { padding-inline: 0.75rem; }

  .a-year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
  }
  .a-name { font-family: var(--font-display); font-size: 1rem; transition: color 0.25s ease; }
  .archive a:hover .a-name { color: var(--accent); }
  .a-blurb { color: var(--muted); font-size: 0.875rem; }
  .a-tags {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--faint);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .archive a { grid-template-columns: 60px 1fr; gap: 0.35rem 1rem; }
    .a-blurb { grid-column: 2; }
    .a-tags { grid-column: 2; }
  }
</style>

<script>
  // カードのホバー位置に光を追従させる
  const cards = document.querySelectorAll<HTMLElement>('.card');
  cards.forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
